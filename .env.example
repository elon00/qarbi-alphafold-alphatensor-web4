# ============================================================================
# QARBI Arbitrum Web4 AlphaFold & AlphaTensor Environment Configuration
# NEVER commit real secrets or private keys to version control.
# ============================================================================

# Arbitrum Network Selection: arbitrum-sepolia (421614) | arbitrum-one (42161)
ARBITRUM_NETWORK=arbitrum-sepolia
ARBITRUM_CHAIN_ID=421614

# QuickNode Arbitrum Endpoints (https://www.quicknode.com/docs/arbitrum)
QUICKNODE_RPC_URL=https://example-endpoint.arbitrum-sepolia.quiknode.pro/YOUR_TOKEN_HERE/
QUICKNODE_WSS_URL=wss://example-endpoint.arbitrum-sepolia.quiknode.pro/YOUR_TOKEN_HERE/
QUICKNODE_API_KEY=

# Fallback Arbitrum Sepolia Public RPC
ARBITRUM_FALLBACK_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Explorer API Verification (https://sepolia.arbiscan.io / https://arbiscan.io)
ARBISCAN_API_KEY=

# x402 Bazaar Payment Facilitator Configuration (https://x402.org)
X402_FACILITATOR_URL=https://x402.org/facilitator
X402_RECEIPT_DB_PATH=./data/x402_receipts.sqlite3
X402_PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Reown AppKit / WalletConnect Project ID (https://docs.reown.com/appkit/overview)
REOWN_PROJECT_ID=

# AlphaFold & AlphaTensor Compute Artifacts Path
ALPHAFOLD_WEIGHTS_DIR=./data/alphafold_params
ALPHATENSOR_DECOMPOSITIONS_DIR=./data/alphatensor_decompositions

# Multimodel AI Agent Provider Keys (Optional - Never log or expose)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Human Approval Gate Flag (Must remain false in automated CI)
HUMAN_MAINNET_APPROVAL_GRANTED=false
